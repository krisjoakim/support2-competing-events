{
  "model_family": "Histogram gradient boosting",
  "features": [
    "adl_patient_reported",
    "diagnosis_group",
    "hospital_day_at_study_entry",
    "diagnosis_class",
    "adl_surrogate_reported",
    "bilirubin",
    "age",
    "mean_arterial_pressure",
    "creatinine",
    "blood_urea_nitrogen",
