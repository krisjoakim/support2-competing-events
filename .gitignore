# Operating-system and editor files
.DS_Store
.idea/
.vscode/
*.swp

# Python environments and caches
.venv/
.venv-*/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Jupyter state
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example

# Local patient-level data and fitted-model artifacts
data/processed/
*.csv
*.parquet
*.pkl
*.joblib

# Aggregate reproducibility tables are part of the project.
!results/**/*.csv

# Optional local prediction exports
results/predictions.csv

# Temporary and log files
*.log
*.tmp
*.temp
~$*

# The published report is Markdown (source) and PDF (distributable) only.
# The .docx is build_report.py's intermediate output on the way to the PDF,
# and the script itself is a local authoring tool, not part of the
# published project.
report/project_report.docx
report/build_report.py

# Local publication copies; never include in the repository
dist/
